# Otto environment variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored and never committed.

# Credentials for your target application (used by fill_secret tool)
APP_USERNAME=your_username
APP_PASSWORD=your_password

# Optional: Twilio credentials for 2FA OTP retrieval (get_2fa_code tool)
# Sign up at https://twilio.com — use a Twilio number as the 2FA phone on target accounts.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=14155551234   # digits only; leading + is stripped automatically if present
